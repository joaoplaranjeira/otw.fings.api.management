# Docker Desktop: use host.docker.internal. For dotnet run outside Docker, use localhost.
ConnectionStrings__DefaultConnection=server=host.docker.internal;database=fings;user=fings;password=change-me
Jwt__Issuer=otw.fings.api.management
Jwt__Audience=otw.fings.client
Jwt__SecretKey=replace-with-at-least-32-random-characters
Loops__ApiKey=
Loops__TransactionalId=
Otp__BypassEnabled=false
OpenAI__ApiKey=
OpenAI__ExtractionModel=gpt-4o
OpenAI__Model=gpt-4o-mini
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5175
