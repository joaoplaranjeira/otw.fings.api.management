{
  "WebPush": {
    "Subject": "mailto:geral@fings.pt",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Notifications": {
    "DefaultEnabled": true,
    "DefaultEnabledByType": {
      "Expense.Created": true,
      "Expense.Updated": true,
      "Expense.Deleted": true,
      "Budget.UsageChanged": true,
      "RecurringExpense.Materialized": true,
      "Household.MemberAdded": true,
      "Household.InvitationAccepted": true
    },
    "EventBatchSize": 50,
    "DeliveryBatchSize": 100,
    "PollIntervalSeconds": 10
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "otw.fings.api.management",
    "Audience": "otw.fings.client",
    "SecretKey": ""
  },
  "Loops": {
    "ApiKey": "",
    "TransactionalId": "",
    "InvitationTransactionalId": ""
  },
  "HouseholdInvitations": {
    "FrontendBaseUrl": "https://otw-fings-frontend-web.onrender.com",
    "ExpirationDays": 7
  },
  "Otp": {
    "BypassEnabled": true
  },
  "OpenAI": {
    "ApiKey": "",
    "ExtractionModel": "gpt-4o",
    "Model": "gpt-4o-mini",
    "VerifyReceiptValues": false,
    "MinimumReceiptImageQuality": 80,
    "MaximumReceiptBytes": 10485760
  },
  "Cors": {
    "AllowedOrigins": [
      "https://otw-fings-frontend-web.onrender.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
